# ==========================================
# Telegram Bot & Lightweight LLM Configuration
# ==========================================

# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Local LLM settings (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Token generation limit and temperature
MAX_RESPONSE_TOKENS=600
TEMPERATURE=0.4

# Optional: Hardware tracking configuration
HARDWARE_CONFIG_FILE=hardware.txt
HARDWARE_CACHE_FILE=hardware_cache.json

# Optional: Dedicated Search API key (DuckDuckGo is used by default with zero config)
# BRAVE_SEARCH_API_KEY=

# Optional: Restrict bot to specific group/chat IDs (comma-separated). Leave empty to allow any chat.
# Example: ALLOWED_CHAT_IDS=-1001234567890,987654321
ALLOWED_CHAT_IDS=
